<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>org.mocaris.plugin.FlutterTools</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>FlutterTools</name>
    <resource-bundle>messages.FlutterToolsBundle</resource-bundle>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="imocaris@outlook.com" url="https://github.com/Mocaris/FlutterTools">Zovey(Mocaris)
    </vendor>
    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="fluttertools-dart.xml">Dart</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="other" id="fluttertools.settings" displayName="FlutterTools"
                             instance="com.mocaris.plugin.flutter.tools.core.settings.FlutterToolsConfigurable"/>
        <postStartupActivity implementation="com.mocaris.plugin.flutter.tools.FlutterToolsActivity"/>
        <notificationGroup displayType="BALLOON" id="FlutterTools"/>
        <toolWindow id="FlutterTools" anchor="right" icon="/icons/flutterTools.svg"
                    factoryClass="com.mocaris.plugin.flutter.tools.toolwindow.FlutterToolsToolWindowFactory"/>
        <psi.referenceContributor language="yaml"
                                  implementation="com.mocaris.plugin.flutter.tools.dependencies.navigation.PubspecReferences"/>
        <completion.contributor language="yaml" order="first"
                                implementationClass="com.mocaris.plugin.flutter.tools.dependencies.completion.PubspecPackageCompletion"/>
        <completion.confidence language="yaml" order="first"
                               implementationClass="com.mocaris.plugin.flutter.tools.dependencies.completion.PubspecPackageCompletionConfidence"/>
        <typedHandler implementation="com.mocaris.plugin.flutter.tools.dependencies.completion.PubspecPackageTypedHandler"/>
        <annotator language="yaml" implementationClass="com.mocaris.plugin.flutter.tools.assets.inspection.ResourceAnnotator"/>
        <annotator language="yaml"
                   implementationClass="com.mocaris.plugin.flutter.tools.dependencies.inspection.PubspecAnnotator"/>
        <codeInsight.inlayProvider language="yaml"
                                   implementationClass="com.mocaris.plugin.flutter.tools.dependencies.inspection.PubspecInlayHints"/>
    </extensions>
    <actions>
        <group id="FlutterTools.ProjectViewPopup" popup="true" text="FlutterTools"
               class="com.mocaris.plugin.flutter.tools.core.FlutterProjectActionGroup">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <action id="FlutterTools.OpenPlatformProject"
                    class="com.mocaris.plugin.flutter.tools.platform.OpenPlatformProjectAction"/>
            <action id="FlutterTools.GenerateSelectedAssets"
                    class="com.mocaris.plugin.flutter.tools.assets.actions.GenerateSelectedAssetsAction"/>
            <action id="FlutterTools.RegisterAssets"
                    class="com.mocaris.plugin.flutter.tools.assets.actions.RegisterAssetsAction"/>
            <action id="FlutterTools.RegisterAssetsRecursively"
                    class="com.mocaris.plugin.flutter.tools.assets.actions.RegisterAssetsRecursivelyAction"/>
        </group>
        <!-- Add your actions here -->
        <group compact="true" id="FlutterTools.Mocaris" popup="true" text="FlutterTools">
            <add-to-group anchor="first" group-id="ToolsMenu"/>
            <action class="com.mocaris.plugin.flutter.tools.toolwindow.OpenToolWindowAction"
                    id="FlutterTools.OpenToolWindow"/>
            <action class="com.mocaris.plugin.flutter.tools.toolwindow.SearchPackagesAction"
                    id="FlutterTools.SearchPackages"/>
            <action class="com.mocaris.plugin.flutter.tools.toolwindow.OpenWorkspaceAction"
                    id="FlutterTools.OpenWorkspace"/>
            <separator/>
            <action class="com.mocaris.plugin.flutter.tools.assets.actions.AssetsAction"
                    id="AssetsSync" popup="true"/>
            <action class="com.mocaris.plugin.flutter.tools.dependencies.CheckPackagesAction"
                    id="FlutterTools.CheckPackages"/>
            <action class="com.mocaris.plugin.flutter.tools.dependencies.commands.RunPubGetAction"
                    id="FlutterTools.RunPubGet"/>
            <separator/>
            <action class="com.mocaris.plugin.flutter.tools.toolwindow.OpenProjectSettingsAction"
                    id="FlutterTools.OpenProjectSettings"/>
            <action class="com.mocaris.plugin.flutter.tools.core.settings.OpenSettingsAction"
                    id="FlutterTools.OpenSettings"/>
        </group>
    </actions>
</idea-plugin>
